        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-BLUDIA-API-KEY",
        "description": "Your project API key, for example `bludia_production_k3x9qa_...`."
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "End-user access token from login, register, or refresh. Required with `end_users` keys."
      }
    },
    "schemas": {
      "Record": {
        "type": "object",
        "description": "System fields plus one key per collection field (by field name). Relation fields are `{id, label}` objects or arrays of them.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "slug": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "children": {
            "description": "Related records requested with `with`, keyed by collection name.",
            "oneOf": [
              {
                "type": "array"
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            ]
          }
        },
        "additionalProperties": true
      },
      "RecordInput": {
        "type": "object",
        "description": "Field values by field name. Optional system fields: `slug`, `published_at`. On update, optional `version` for optimistic concurrency.",
        "properties": {
          "slug": {
            "type": "string"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      },
      "RecordEnvelope": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Record"
          }
        },
        "required": [
          "data"
        ]
      },
      "RecordList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Record"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PageMeta"
          },
          "totals": {
            "description": "Column totals configured in collection settings."
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "PageMeta": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "total": {
            "type": "integer",
            "description": "Matching records visible to the caller."
          },
          "pages": {
            "type": "integer"
          },
          "trashed": {
            "type": "integer",
            "description": "Matching records in the trash."
          }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT, valid for `expires_in` seconds."
          },
          "refresh_token": {
            "type": "string",
            "description": "Opaque token; rotates on every refresh."
          },
          "token_type": {
            "type": "string",
            "const": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "description": "Seconds until the access token expires (default 900)."
          },
          "record_id": {
            "type": "integer",
            "description": "The user's record ID."
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "session": {
            "$ref": "#/components/schemas/Session"
          }
        }
      },
      "RegisterResponse": {
        "type": "object",
        "properties": {
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_verification"
            ],
            "description": "Present when email verification is on."
          }
        }
      },
      "CurrentUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "pending",
              "inactive",
              "banned",
              "suspended"
            ]
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "Message": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "AuthError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Machine-readable code, for example `invalid_credentials`."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": {
            "type": "boolean",
            "const": false
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "description": "Field errors, when available."
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid API key or access token.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Message"
            },
            "example": {
              "message": "Missing API key."
            }
          }
        }
      },
      "Forbidden": {
        "description": "Key revoked or expired, origin not allowed, or no permission.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AuthError"
            },
            "example": {
              "error": "permission_denied",
              "message": "You do not have [delete] permission on collection [14]."
            }
          }
        }
      },
      "NotFound": {
        "description": "Collection, guard, or record not found (or not visible).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Validation failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limit exceeded.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Message"
            },
            "example": {
              "message": "Rate limit exceeded."
            }
          }
        }
      }
    }
  }
}