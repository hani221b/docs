    "global": {
      "anchors": [
        {
          "anchor": "API Reference",
          "href": "/api-reference/overview",
          "icon": "brackets"
        },
        {
          "anchor": "Guides",
          "href": "/guides/build-crm",
          "icon": "book-open"
        }
      ]
    }
  },

  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@bludia.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://bludia.com"
    }
  },

  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },

  "footer": {
    "socials": {
      "x": "https://x.com/Bludia",
      "linkedin": "https://www.linkedin.com/company/bludia"
    }
  },

  "icons": {
    "library": "lucide"
  },

  "appearance": {
    "default": "system"
  },

  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#F8FAFC",
      "dark": "#0F172A"
    }
  },

  "fonts": {
    "family": "Ubuntu"
  }
