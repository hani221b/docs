          },

          {
            "group": "API",
            "pages": []
          },
          {
            "group": "Authentication & Security",
            "pages": []
          },

          {
            "group": "Hooks & Backend Logic",
            "pages": []
          },

          {
            "group": "Files & Storage",
            "pages": []
          },
          {
            "group": "Reports & Analytics",
            "pages": []
          },

          {
            "group": "Frontend Integration",
            "pages": []
          },
          {
            "group": "Hosting & Operations",
            "pages": []
          },

          {
            "group": "Guides",
            "pages": []
          },

          {
            "group": "Migration",
            "pages": []
