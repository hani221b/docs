{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bludia Documentation",
  "description": "Bludia is a backend platform: collections, a REST API, end-user authentication, role-based access control, row-level security, hooks, messaging, files, reports, and scheduled functions for your app.",
  "colors": {
    "primary": "#3B82F6",
    "light": "#60A5FA",
    "dark": "#1D4ED8"
  },
  "favicon": {
    "light": "/images/Group21(1).png",
    "dark": "/images/Group21(1).png"
  },
  "logo": {
    "light": "/images/logo.png",
    "dark": "/images/logo.png"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart",
              "concepts",
              "projects"
            ]
          },
          {
            "group": "Database",
            "pages": [
              "database/overview",
              "database/collections",
              "database/fields",
              "database/validation",
              "database/records",
              "database/relations",
              "database/computed-fields",
              "database/import-export"
            ]
          },
          {
            "group": "REST API",
            "pages": [
              "api/overview",
              "api/authentication",
              "api/api-keys",
              "api/querying",
              "api/errors",
              "api/rate-limits",
              "api/cors"
            ]
          },
          {
            "group": "Authentication",
            "pages": [
              "authentication/overview",
              "authentication/guards",
              "authentication/register-and-login",
              "authentication/sessions-and-tokens",
              "authentication/email-verification",
              "authentication/password-reset",
              "authentication/current-user"
            ]
          },
          {
            "group": "Authorization & security",
            "pages": [
              "authorization/overview",
              "authorization/roles-and-permissions",
              "authorization/row-level-security",
              "authorization/team-members",
              "authorization/security-checklist"
            ]
          },
          {
            "group": "Hooks",
            "pages": [
              "hooks/overview",
              "hooks/lifecycle-events",
              "hooks/writing-hooks",
              "hooks/sdk-reference",
              "hooks/versions",
              "hooks/runtime-and-limits",
              "hooks/logs-and-debugging",
              "hooks/best-practices"
            ]
          },
          {
            "group": "Messaging",
            "pages": [
              "messaging/overview",
              "messaging/channels",
              "messaging/templates"
            ]
          },
          {
            "group": "Files & storage",
            "pages": [
              "files/overview"
            ]
          },
          {
            "group": "Reports & automation",
            "pages": [
              "reports/overview",
              "reports/dashboards",
              "reports/pdf-templates",
              "automation/scheduled-functions"
            ]
          },
          {
            "group": "Frontend integration",
            "pages": [
              "frontend/overview",
              "frontend/javascript-client",
              "frontend/react",
              "frontend/server-side"
            ]
          },
          {
            "group": "Hosting & operations",
            "pages": [
              "hosting/overview",
              "hosting/backups-and-exports"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Build an app",
            "pages": [
              "guides/build-crm",
              "guides/customer-portal",
              "guides/booking-notifications"
            ]
          },
          {
            "group": "Migration",
            "pages": [
              "guides/migrate-existing-data"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/overview"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.json"
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "reference/at-a-glance",
              "reference/limits-and-defaults",
              "reference/glossary",
              "reference/faq"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "troubleshooting/common-errors"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "API Reference",
          "href": "/api-reference/overview",
          "icon": "braces"
        },
        {
          "anchor": "Guides",
          "href": "/guides/build-crm",
          "icon": "book-open"
        },
        {
          "anchor": "Bludia at a glance",
          "href": "/reference/at-a-glance",
          "icon": "sparkles"
        }
      ]
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@bludia.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://bludia.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:site_name": "Bludia Docs",
      "og:type": "website"
    }
  },
  "search": {
    "prompt": "Search Bludia docs: collections, API keys, auth guards, hooks..."
  },
  "footer": {
    "socials": {
      "x": "https://x.com/Bludia",
      "linkedin": "https://www.linkedin.com/company/bludia"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#F8FAFC",
      "dark": "#0F172A"
    }
  },
  "fonts": {
    "family": "Ubuntu"
  },
